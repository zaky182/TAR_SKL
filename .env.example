# Salin menjadi .env (lokal) atau isi di tab Environment Dokploy
NODE_ENV=production
PORT=3000

# Connection string dari service PostgreSQL Dokploy (Internal Connection URL)
DATABASE_URL=postgresql://tar_user:GANTI_PASSWORD@tar-db:5432/tar_db

# Wajib, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=

# Lokasi penyimpanan foto (harus di-mount sebagai volume)
UPLOAD_DIR=/data/uploads

# Kunci tanda tangan elektronik (QR). Isi sekali dan JANGAN diganti, atau QR pada dokumen lama menjadi tidak valid.
# Buat dengan: openssl rand -hex 32  (bila kosong dipakai turunan JWT_SECRET)
SIGN_SECRET=

# URL publik aplikasi (dipakai pada payload webhook)
APP_URL=https://tar.planthml.my.id

# Opsional: set true jika koneksi DB membutuhkan SSL
# PGSSL=false
# Opsional: paksa flag Secure pada cookie (default: true saat production)
# COOKIE_SECURE=true
